{
  "id": "todo",
  "name": "Todo",
  "description": "Template-derived Todo UI and API with progressive JSON/PostgreSQL/Go API storage.",
  "version": "0.1.0",
  "enabled": true,
  "depend_on": [
    "@node"
  ],
  "execservice": "@node",
  "args": [
    "${SERVICE_ARTIFACT_ROOT}/runtime/server.mjs"
  ],
  "endpoints": [
    {
      "id": "web",
      "kind": "network",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 18552,
        "strategy": "preferred"
      },
      "exposure": "local",
      "primary": true
    },
    {
      "id": "ui",
      "kind": "url",
      "target": "web",
      "url": "http://127.0.0.1:${endpoint.web.port}/",
      "exposure": "local",
      "primary": true
    }
  ],
  "env": {
    "TODO_PORT": "${endpoint.web.port}",
    "TODO_DATA_FILE": "${SERVICE_ROOT}/data/todos.json"
  },
  "healthchecks": [
    {
      "id": "http-health",
      "type": "http",
      "url": "http://127.0.0.1:${endpoint.web.port}/healthz",
      "expected_status": 200,
      "retries": 80,
      "interval": 250
    }
  ],
  "meta": {
    "license": "Apache-2.0",
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-todo.git"
    },
    "documentationUrl": "https://github.com/service-lasso/lasso-todo/blob/develop/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-todo/issues"
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-todo",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-todo-win32.zip",
        "archiveType": "zip",
        "command": "./runtime/server.mjs",
        "args": [],
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      },
      "linux": {
        "assetName": "lasso-todo-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/server.mjs",
        "args": [],
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      },
      "darwin": {
        "assetName": "lasso-todo-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/server.mjs",
        "args": [],
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      }
    }
  }
}
